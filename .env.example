# Copia este fichero a `.env` y rellena tus valores.
# NUNCA subas el `.env` real al repositorio (ya está en .gitignore).

# Clave de API de Gemini. Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a usar. `gemini-2.5-flash` funciona en el free tier.
GEMINI_MODEL=gemini-2.5-flash

# Tamaño máximo de archivo permitido en megabytes.
MAX_FILE_SIZE_MB=15

# Orígenes permitidos por CORS (separados por coma). Por defecto el dev server de Angular.
CORS_ORIGINS=http://localhost:4200
